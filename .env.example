# Copia este archivo como .env y rellena lo que necesites.
# En producción, estas mismas variables van en el panel de Netlify.

# --- Imprescindible para que la herramienta responda ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Brevo: alta del contacto y envío del correo ---
BREVO_API_KEY=
BREVO_LISTA_ID=14
CORREO_REMITENTE=hola@fisioia.app
# CORREO_NOMBRE=FisioIA

# Brevo manda también el correo de acceso. Solo hace falta tocar esto si algún
# día se cambia de proveedor.
# PROVEEDOR_CORREO=brevo
# RESEND_API_KEY=

# --- Enlace que se manda por correo ---
# URL_PUBLICA=https://tu-dominio

# --- Topes de consumo ---
# LIMITE_DIARIO=40
# CUPO_DIARIO_GLOBAL=2000

# --- Solo para desarrollo local: salta la puerta del correo.
#     Se ignora en Netlify. ---
# ACCESO_LIBRE=1
