{
  "name": "fisioia-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Asistente de razonamiento clínico: batería de tests para una sospecha e interpretación por precisión diagnóstica",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node pruebas.js",
    "verificar": "node --env-file-if-exists=.env verificacion.js",
    "auditar": "node --env-file-if-exists=.env auditoria.js",
    "dev": "ACCESO_LIBRE=1 node --env-file-if-exists=.env server.js",
    "limpiar": "node --env-file-if-exists=.env limpiar.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@netlify/blobs": "^8.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
